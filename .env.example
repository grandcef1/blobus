# Backend only! Браузер с Supabase напрямую не общается — все запросы идут через /api
SUPABASE_URL=https://your-project.supabase.co
# publishable идентифицирует приложение и ограничен RLS
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# secret обходит RLS, только серверный, никогда не VITE_ и никогда в браузер
SUPABASE_SECRET_KEY=sb_secret_your-key
# legacy anon/service_role устаревают к концу 2026 и не используются

# LLM-шлюз OpenRouter (не OpenAI напрямую). Ключ только серверный, никогда не VITE_* и обязателен:
# без него сервер не стартует (fail-fast), а чат отвечает 500 — анонимного заказа модели нет
OPENROUTER_API_KEY=sk-or-your-key-here

# Локальный порт API, по умолчанию 8787; на Vercel не используется
# PORT=8787

# Включённые OAuth-провайдеры входа, список через запятую (сейчас поддерживается google). Не секрет:
# публичный GET /api/auth/providers отдаёт ровно эти имена, а клиент по ним рисует кнопки. Дефолт — google;
# пустое значение выключает провайдерные кнопки целиком.
# AUTH_OAUTH_PROVIDERS=google

# Публичный адрес сайта: canonical, og:url, sitemap.xml и robots.txt. Реальный домен проекта —
# https://blobus-ai.vercel.app (blobus.vercel.app не существует). Это же значение задано в Vercel.
VITE_SITE_URL=https://blobus-ai.vercel.app

# Переключатель мок-API: "true" (значение по умолчанию) — данные из src/api/mocks, "false" — реальный
# бэкенд через api/client. Любое другое значение оставляет моки включёнными: сборка без .env должна
# работать без сервера.
VITE_USE_MOCKS=true

# Адрес приёмника отчётов об ошибках (first-party). Пусто = канал выключен: пока бэкенда нет, в
# проде не задаём. Он не связан с VITE_USE_MOCKS — источник данных и канал ошибок независимы.
# При появлении бэкенда: VITE_ERROR_LOG_ENDPOINT=/logs/client-error.
VITE_ERROR_LOG_ENDPOINT=

# DSN Sentry для технических отчётов об ошибках. Пустое значение выключает Sentry целиком: SDK не
# загружается, сторонних запросов нет. DSN публичный и send-only — это не секрет.
VITE_SENTRY_DSN=