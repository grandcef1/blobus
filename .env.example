# Supabase Configuration (Backend only!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# OpenAI API (Backend only!)
OPENAI_API_KEY=sk-your-key-here

# Frontend variables (public, accessible in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Публичный адрес сайта: canonical, og:url, sitemap.xml и robots.txt. Реальный домен проекта —
# https://blobus-ai.vercel.app (blobus.vercel.app не существует). Это же значение задано в Vercel.
VITE_SITE_URL=https://blobus-ai.vercel.app

# Переключатель мок-API: "true" (значение по умолчанию) — данные из src/api/mocks, "false" — реальный
# бэкенд через api/client. Любое другое значение оставляет моки включёнными: сборка без .env должна
# работать без сервера.
VITE_USE_MOCKS=true

# Адрес приёмника отчётов об ошибках (first-party). Пусто = канал выключен: пока бэкенда нет, в
# проде не задаём. Он не связан с VITE_USE_MOCKS — источник данных и канал ошибок независимы.
# При появлении бэкенда: VITE_ERROR_LOG_ENDPOINT=/logs/client-error.
VITE_ERROR_LOG_ENDPOINT=

# DSN Sentry для технических отчётов об ошибках. Пустое значение выключает Sentry целиком: SDK не
# загружается, сторонних запросов нет. DSN публичный и send-only — это не секрет.
VITE_SENTRY_DSN=