{
    "printWidth": 100,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "arrowParens": "always",
    "overrides": [
        {
            "files": "src/locales/**/*.json",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
